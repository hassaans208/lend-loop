# Copy to .env.local (Next.js + Convex CLI) and .env (docker compose).
# Never commit real values. Convex *server* variables are set with
# `npx convex env set NAME value`, not read from this file at runtime.

# ---------- Clerk (Next.js) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---------- Convex (Next.js / CLI) ----------
# Written by `npx convex dev` on first run.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
# Only for CI/CD deploys (`npx convex deploy`). Keep out of local files if you can.
CONVEX_DEPLOY_KEY=

# ---------- Convex server env (set via `npx convex env set`) ----------
# Issuer of the Clerk "convex" JWT template, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# Comma-separated, verified emails that become admins on sign-in.
ADMIN_EMAILS=you@example.com
# Production webhook URL of the "LendLoop: Request notification" workflow.
# Convex runs in the cloud, so it must reach n8n over a public URL (e.g. a tunnel to localhost:5678).
N8N_WEBHOOK_URL=https://your-tunnel.example.com/webhook/lendloop-loan-events
# Shared HMAC secret. Generate with: openssl rand -hex 32. Same value in Convex and n8n.
LENDLOOP_WEBHOOK_SECRET=

# ---------- n8n (docker compose reads .env) ----------
# Encrypts n8n's stored credentials. Generate once with: openssl rand -hex 32, then never change it.
N8N_ENCRYPTION_KEY=
# Public base URL n8n reports for its webhooks (the tunnel URL in local dev).
N8N_PUBLIC_URL=http://localhost:5678/
# Convex HTTP actions base URL (note: .convex.site, not .convex.cloud).
CONVEX_SITE_URL=https://your-deployment-name.convex.site
LENDLOOP_APP_URL=http://localhost:3000
LENDLOOP_MAIL_FROM=LendLoop <no-reply@lendloop.local>
# Optional: where the Error Workflow sends alerts.
LENDLOOP_ALERT_EMAIL=ops@lendloop.local

# ---------- SMTP (used when creating the n8n "LendLoop SMTP" credential) ----------
# Local defaults point at the Mailpit container. In production use a real provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
